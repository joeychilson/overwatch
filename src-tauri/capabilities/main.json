{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Core desktop access for the app's window, and for the menu bar item's panel to size, theme and hide itself.",
  "windows": ["main", "panel"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-set-size",
    "core:window:allow-set-theme",
    "core:window:allow-hide"
  ]
}
